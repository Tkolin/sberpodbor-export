# Copy to .env and fill in. Never commit .env.
#
# Generate the two secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"          -> SP_JWT_SECRET
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" -> SP_ENCRYPTION_KEY

POSTGRES_DB=sberpodbor
POSTGRES_USER=sberpodbor
POSTGRES_PASSWORD=change-me

# Signs admin session tokens. Rotating it logs everyone out.
SP_JWT_SECRET=change-me

# Fernet key encrypting Сбер Подбор account passwords and proxy URLs at rest.
# LOSING THIS MAKES STORED ACCOUNT CREDENTIALS UNREADABLE — back it up separately from the database.
SP_ENCRYPTION_KEY=change-me

# Created on first boot only, if no admin exists yet. Leave the password empty to skip
# bootstrapping and create the first admin manually with `make createadmin`.
SP_BOOTSTRAP_ADMIN_EMAIL=admin@sberpodbor.local
SP_BOOTSTRAP_ADMIN_PASSWORD=

# Comma-separated extra CORS origins. Empty is correct when the UI is served through nginx.
SP_CORS_ORIGINS=

SP_HTTP_PORT=80
SP_HTTPS_PORT=443

# Scraper tuning. Defaults are the values measured as stable against api.sberpodbor.ru:
# ~4-5 rps per account, throttled by latency rather than by a request counter.
SP_LANE_CONCURRENCY=14
SP_MIN_INTERVAL_MS=100
SP_REQ_TIMEOUT_S=30
